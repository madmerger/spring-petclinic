{
  "family": "spring-petclinic",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/ecsTaskRole",
  "runtimePlatform": {
    "operatingSystemFamily": "LINUX",
    "cpuArchitecture": "X86_64"
  },
  "containerDefinitions": [
    {
      "name": "spring-petclinic",
      "image": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/spring-petclinic:latest",
      "essential": true,
      "portMappings": [
        {
          "name": "http",
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "environment": [
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "aws"
        }
      ],
      "secrets": [
        {
          "name": "RDS_URL",
          "valueFrom": "arn:aws:ssm:<REGION>:<ACCOUNT_ID>:parameter/spring-petclinic/RDS_URL"
        },
        {
          "name": "RDS_USERNAME",
          "valueFrom": "arn:aws:ssm:<REGION>:<ACCOUNT_ID>:parameter/spring-petclinic/RDS_USERNAME"
        },
        {
          "name": "RDS_PASSWORD",
          "valueFrom": "arn:aws:ssm:<REGION>:<ACCOUNT_ID>:parameter/spring-petclinic/RDS_PASSWORD"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "wget -qO- http://localhost:8080/actuator/health | grep -q '\"status\":\"UP\"' || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/spring-petclinic",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
